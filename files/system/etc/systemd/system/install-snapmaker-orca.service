[Unit]
Description=Install Snapmaker Orca flatpak bundle
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/install-snapmaker-orca.stamp

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/lib/fabrial-os/install-snapmaker-orca.sh
ExecStartPost=/bin/touch /var/lib/install-snapmaker-orca.stamp
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
